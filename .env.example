# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# Cloud SQL Runtime Environment Variables (automatically provided by AI Studio)
SQL_HOST="/cloudsql/instance"
SQL_DB_NAME="postgres"
SQL_USER="app_user"
SQL_PASSWORD=""

# Cloud SQL Schema Management Variables (automatically provided for Drizzle Kit)
SQL_ADMIN_USER="postgres"
SQL_ADMIN_PASSWORD=""
